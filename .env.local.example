# ============================================
# ThinkPost AI — Environment Variables
# ============================================
# Copy this file to .env.local and fill in your values.
# See SETUP.md for how to obtain each value.

# --- Supabase (Postgres database only) ---
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# --- WorkOS AuthKit ---
WORKOS_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
WORKOS_CLIENT_ID=client_your-workos-client-id
WORKOS_REDIRECT_URI=http://localhost:3000/auth/callback
WORKOS_COOKIE_PASSWORD=a-32-character-or-longer-random-string

# --- Upstash Redis (rate limiting only) ---
UPSTASH_REDIS_REST_URL=https://your-redis.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-upstash-token

# --- Application ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
